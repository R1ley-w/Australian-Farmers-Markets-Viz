{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Distance from each local government area's centre to the nearest farmers' market, using a log scale the values span 0.1 km to 2,228 km. A slider hides council areas further than the chosen distance from a market.",
  "width": "container",
  "height": 520,
  "params": [
    {
      "name": "maxKm",
      "value": 2300,
      "bind": {
        "input": "range",
        "min": 10,
        "max": 2300,
        "step": 10,
        "name": "Show council areas within (km)  "
      }
    }
  ],
  "projection": {
    "type": "conicEqualArea",
    "parallels": [-18, -36],
    "rotate" : [-132, 0, 0]
  },
  "layer": [
    {
      "data": {
        "url": "data/lga.topo.json",
        "format": {
          "type": "topojson",
          "feature": "LGA_2023_AUST_GDA2020"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#e9eaec",
        "stroke": "#cdced1",
        "strokeWidth": 0.25,
        "tooltip": false
      }
    },
    {
      "data": {
        "url": "data/lga.topo.json",
        "format": {
          "type": "topojson",
          "feature": "LGA_2023_AUST_GDA2020"
        }
      },
      "transform": [
        {
          "lookup": "properties.code",
          "from": {
            "data": {
              "url": "data/lga_distance.csv"
            },
            "key": "lga_code",
            "fields": [
              "lga",
              "state",
              "km_to_nearest_market",
              "nearest_market"
            ]
          }
        },
        {
          "filter": "isValid(datum.km_to_nearest_market)"
        },
        {
          "filter": "datum.km_to_nearest_market <= maxKm"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#fdfdfc",
        "strokeWidth": 0.25
      },
      "encoding": {
        "color": {
          "field": "km_to_nearest_market",
          "type": "quantitative",
          "title": [
            "Kilometres to the",
            "nearest market"
          ],
          "scale": {
            "type": "log",
            "domain": [
              2,
              2300
            ],
            "range": [
              "#feefde",
              "#f7dcbc",
              "#edc698",
              "#ddac6e",
              "#c58d41",
              "#a96f10",
              "#8c5600",
              "#6e4000",
              "#4f2c00"
            ],
            "clamp": true
          },
          "legend": {
            "orient": "top-left",
            "gradientLength": 160,
            "values": [
              5,
              25,
              100,
              500,
              2000
            ],
            "format": ",.0f"
          }
        },
        "tooltip": [
          {
            "field": "lga",
            "type": "nominal",
            "title": "LGA"
          },
          {
            "field": "state",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "km_to_nearest_market",
            "type": "quantitative",
            "title": "Distance (km)",
            "format": ",.0f"
          },
          {
            "field": "nearest_market",
            "type": "nominal",
            "title": "Nearest market"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/markets.csv"
      },
      "transform": [
        {
          "filter": "datum.is_duplicate == 0 && datum.geocode_ok == 1"
        }
      ],
      "mark": {
        "type": "circle",
        "size": 11,
        "color": "#1c1f23",
        "opacity": 0.9
      },
      "encoding": {
        "longitude": {
          "field": "lng",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "tooltip": [
          {
            "field": "name",
            "type": "nominal",
            "title": "Market"
          }
        ]
      }
    }
  ]
}
