{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Distance from each local government area's centre to the nearest farmers' market. Darker means further away.",
  "width": "container",
  "height": 520,
  "params": [
    {
      "name": "maxKm",
      "value": 200,
      "bind": {
        "input": "range", "min": 25, "max": 400, "step": 25,
        "name": "Colour scale tops out at (km)  "
      }
    }
  ],
  "projection": { "type": "mercator" },
  "layer": [
    {
      "data": {
        "url": "data/lga.topo.json",
        "format": { "type": "topojson", "feature": "LGA_2023_AUST_GDA2020" }
      },
      "transform": [
        {
          "lookup": "properties.code",
          "from": {
            "data": { "url": "data/lga_distance.csv" },
            "key": "lga_code",
            "fields": ["lga", "state", "km_to_nearest_market", "nearest_market"]
          }
        },
        { "filter": "isValid(datum.km_to_nearest_market)" },
        { "calculate": "min(datum.km_to_nearest_market, maxKm)", "as": "km_capped" }
      ],
      "mark": { "type": "geoshape", "stroke": "#fcfcfb", "strokeWidth": 0.25 },
      "encoding": {
        "color": {
          "field": "km_capped",
          "type": "quantitative",
          "title": ["Kilometres to the", "nearest market"],
          "scale": { "scheme": "blues", "domainMin": 0 },
          "legend": { "orient": "top-left", "gradientLength": 150, "format": ".0f" }
        },
        "tooltip": [
          { "field": "lga", "type": "nominal", "title": "LGA" },
          { "field": "state", "type": "nominal", "title": "State" },
          { "field": "km_to_nearest_market", "type": "quantitative", "title": "Distance (km)", "format": ".0f" },
          { "field": "nearest_market", "type": "nominal", "title": "Nearest market" }
        ]
      }
    },
    {
      "data": { "url": "data/markets.csv" },
      "transform": [{ "filter": "datum.is_duplicate == 0 && datum.geocode_ok == 1" }],
      "mark": { "type": "circle", "size": 9, "color": "#eb6834", "opacity": 0.9 },
      "encoding": {
        "longitude": { "field": "lng", "type": "quantitative" },
        "latitude": { "field": "lat", "type": "quantitative" },
        "tooltip": [{ "field": "name", "type": "nominal", "title": "Market" }]
      }
    }
  ]
}
