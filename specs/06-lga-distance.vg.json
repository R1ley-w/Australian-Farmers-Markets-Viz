{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Distance from each local government area's centre to the nearest farmers' market, using a log scale the values span 0.1 km to 2,228 km. A slider hides council areas further than the chosen distance from a market.",
  "width": "container",
  "height": 520,
  "params": [
    {
      "name": "maxKm",
      "value": 2300,
      "bind": {
        "input": "range",
        "min": 10,
        "max": 2300,
        "step": 10,
        "name": "Show council areas within  "
      }
    }
  ],
  "projection": {
    "type": "conicEqualArea",
    "parallels": [
      -18,
      -36
    ],
    "rotate": [
      -132,
      0,
      0
    ]
  },
  "layer": [
    {
      "data": {
        "url": "data/lga.topo.json",
        "format": {
          "type": "topojson",
          "feature": "LGA_2023_AUST_GDA2020"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#d6d8db",
        "stroke": "#fdfdfc",
        "strokeWidth": 0.25,
        "tooltip": false
      }
    },
    {
      "data": {
        "url": "data/lga.topo.json",
        "format": {
          "type": "topojson",
          "feature": "LGA_2023_AUST_GDA2020"
        }
      },
      "transform": [
        {
          "lookup": "properties.code",
          "from": {
            "data": {
              "url": "data/lga_distance.csv"
            },
            "key": "lga_code",
            "fields": [
              "lga",
              "state",
              "km_to_nearest_market",
              "nearest_market"
            ]
          }
        },
        {
          "filter": "isValid(datum.km_to_nearest_market)"
        },
        {
          "filter": "datum.km_to_nearest_market <= maxKm"
        },
        {
          "calculate": "{'NSW':'New South Wales','VIC':'Victoria','QLD':'Queensland','SA':'South Australia','WA':'Western Australia','TAS':'Tasmania','NT':'Northern Territory','ACT':'Australian Capital Territory'}[datum.state]",
          "as": "stateName"
        },
        {
          "calculate": "replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(datum.nearest_market, regexp('^SCPA - ', 'g'), ''), regexp(' ?\\\\((FAB|GSFMA)\\\\)', 'g'), ''), regexp('SAGE Sustainable', 'g'), 'Sustainable'), regexp('\\\\bSAGE\\\\b', 'g'), 'Sustainable Agriculture and Gardening Eurobodalla'), regexp('\\\\bInc\\\\b\\\\.?|\\\\bINC\\\\b', 'g'), 'Incorporated'), regexp('\\\\bPty Ltd\\\\b', 'g'), 'Proprietary Limited'), regexp('\\\\bPL\\\\b', 'g'), 'Proprietary Limited'), regexp('\\\\bAssoc\\\\b', 'g'), 'Association'), regexp('\\\\bMt\\\\b', 'g'), 'Mount'), regexp('\\\\bSt\\\\b', 'g'), 'Saint'), regexp('\\\\bSth\\\\b', 'g'), 'South'), regexp('\\\\bFM\\\\b', 'g'), 'Farmers’ Market'), regexp('\\\\bQLD\\\\b', 'g'), 'Queensland'), regexp('\\\\bNSW\\\\b', 'g'), 'New South Wales'), regexp('\\\\bCo\\\\b', 'g'), 'Company'), regexp('P&C', 'g'), 'Parents and Citizens Association'), regexp('\\\\bGC\\\\b', 'g'), 'Gold Coast')",
          "as": "nearestFull"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#fdfdfc",
        "strokeWidth": 0.25
      },
      "encoding": {
        "color": {
          "field": "km_to_nearest_market",
          "type": "quantitative",
          "title": [
            "Kilometres to the",
            "nearest market"
          ],
          "scale": {
            "type": "log",
            "domain": [
              2,
              2300
            ],
            "range": [
              "#fffbe0",
              "#fff3b0",
              "#ffe97f",
              "#ffdc4a",
              "#f9c80e",
              "#e0ad00",
              "#bf9000",
              "#977100",
              "#6b5000"
            ],
            "clamp": true
          },
          "legend": {
            "orient": "top-left",
            "gradientLength": 160,
            "values": [
              5,
              25,
              100,
              500,
              2000
            ],
            "format": ",.0f"
          }
        },
        "tooltip": [
          {
            "field": "lga",
            "type": "nominal",
            "title": "Council area"
          },
          {
            "field": "stateName",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "km_to_nearest_market",
            "type": "quantitative",
            "title": "Distance (kilometres)",
            "format": ",.0f"
          },
          {
            "field": "nearestFull",
            "type": "nominal",
            "title": "Nearest market"
          }
        ]
      }
    },
    {
      "data": {
        "graticule": {
          "step": [
            5,
            5
          ],
          "extent": [
            [
              112,
              -44
            ],
            [
              154,
              -10
            ]
          ]
        }
      },
      "mark": {
        "type": "geoshape",
        "filled": false,
        "stroke": "#4a5058",
        "strokeOpacity": 0.35,
        "strokeWidth": 0.6,
        "tooltip": false
      }
    },
    {
      "data": {
        "url": "data/markets.csv"
      },
      "transform": [
        {
          "filter": "datum.is_duplicate == 0 && datum.geocode_ok == 1"
        },
        {
          "calculate": "replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(datum.name, regexp('^SCPA - ', 'g'), ''), regexp(' ?\\\\((FAB|GSFMA)\\\\)', 'g'), ''), regexp('SAGE Sustainable', 'g'), 'Sustainable'), regexp('\\\\bSAGE\\\\b', 'g'), 'Sustainable Agriculture and Gardening Eurobodalla'), regexp('\\\\bInc\\\\b\\\\.?|\\\\bINC\\\\b', 'g'), 'Incorporated'), regexp('\\\\bPty Ltd\\\\b', 'g'), 'Proprietary Limited'), regexp('\\\\bPL\\\\b', 'g'), 'Proprietary Limited'), regexp('\\\\bAssoc\\\\b', 'g'), 'Association'), regexp('\\\\bMt\\\\b', 'g'), 'Mount'), regexp('\\\\bSt\\\\b', 'g'), 'Saint'), regexp('\\\\bSth\\\\b', 'g'), 'South'), regexp('\\\\bFM\\\\b', 'g'), 'Farmers’ Market'), regexp('\\\\bQLD\\\\b', 'g'), 'Queensland'), regexp('\\\\bNSW\\\\b', 'g'), 'New South Wales'), regexp('\\\\bCo\\\\b', 'g'), 'Company'), regexp('P&C', 'g'), 'Parents and Citizens Association'), regexp('\\\\bGC\\\\b', 'g'), 'Gold Coast')",
          "as": "nameFull"
        }
      ],
      "mark": {
        "type": "circle",
        "size": 11,
        "color": "#1c1f23",
        "stroke": "#ffffff",
        "strokeWidth": 0.6,
        "opacity": 0.9
      },
      "encoding": {
        "longitude": {
          "field": "lng",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "tooltip": [
          {
            "field": "nameFull",
            "type": "nominal",
            "title": "Market"
          }
        ]
      }
    }
  ]
}
