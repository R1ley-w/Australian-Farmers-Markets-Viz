{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Every farmers' market in the AFMA directory, coloured by trading frequency and sized by hours open on a market day.",
  "width": "container",
  "height": 540,
  "params": [
    {
      "name": "stateFilter",
      "value": "All states",
      "bind": {
        "input": "select",
        "options": [
          "All states",
          "NSW",
          "VIC",
          "QLD",
          "WA",
          "SA",
          "TAS",
          "ACT"
        ],
        "name": "State  "
      }
    }
  ],
  "projection": {
    "type": "mercator"
  },
  "layer": [
    {
      "data": {
        "url": "data/states.topo.json",
        "format": {
          "type": "topojson",
          "feature": "STE_2021_AUST_GDA2020"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#e8dcc8",
        "fillOpacity": 0.8,
        "stroke": "#c9c2b0",
        "strokeWidth": 0.6
      },
      "encoding": {
        "tooltip": {
          "field": "properties.name",
          "type": "nominal",
          "title": "State"
        }
      }
    },
    {
      "data": {
        "url": "data/markets.csv"
      },
      "transform": [
        {
          "filter": "datum.is_duplicate == 0 && datum.geocode_ok == 1"
        },
        {
          "filter": "stateFilter == 'All states' || datum.state == stateFilter"
        },
        {
          "calculate": "datum.hours_open ? datum.hours_open : 4",
          "as": "hrs"
        }
      ],
      "mark": {
        "type": "circle",
        "stroke": "#fdfcf9",
        "strokeWidth": 0.8,
        "opacity": 0.88,
        "cursor": "pointer"
      },
      "encoding": {
        "longitude": {
          "field": "lng",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "size": {
          "field": "hrs",
          "type": "quantitative",
          "title": "Hours open",
          "scale": {
            "type": "sqrt",
            "domain": [
              2,
              8
            ],
            "range": [
              28,
              190
            ]
          },
          "legend": {
            "orient": "top-left",
            "direction": "horizontal",
            "values": [
              3,
              4,
              5,
              6
            ]
          }
        },
        "color": {
          "field": "frequency",
          "type": "nominal",
          "title": "Trading frequency",
          "sort": [
            "Weekly",
            "Fortnightly",
            "Monthly",
            "Irregular"
          ],
          "legend": {
            "orient": "top-right",
            "direction": "vertical"
          },
          "scale": {
            "domain": [
              "Weekly",
              "Fortnightly",
              "Monthly",
              "Irregular"
            ],
            "range": [
              "#1f4212",
              "#3e722a",
              "#6ba257",
              "#8abd79"
            ]
          }
        },
        "opacity": {
          "condition": {
            "param": "freqSel",
            "value": 0.88
          },
          "value": 0.1
        },
        "href": {
          "field": "url",
          "type": "nominal"
        },
        "tooltip": [
          {
            "field": "name",
            "type": "nominal",
            "title": "Market"
          },
          {
            "field": "suburb",
            "type": "nominal",
            "title": "Where"
          },
          {
            "field": "state",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "market_days_raw",
            "type": "nominal",
            "title": "Trades"
          },
          {
            "field": "frequency",
            "type": "nominal",
            "title": "Frequency"
          },
          {
            "field": "hours_open",
            "type": "quantitative",
            "title": "Hours open",
            "format": ".1f"
          },
          {
            "field": "operator",
            "type": "nominal",
            "title": "Operator"
          }
        ]
      },
      "params": [
        {
          "name": "freqSel",
          "select": {
            "type": "point",
            "fields": [
              "frequency"
            ]
          },
          "bind": "legend"
        }
      ]
    }
  ]
}
