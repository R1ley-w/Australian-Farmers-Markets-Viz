{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "Sunburst of trading frequency by state. Inner ring: each state, sized by its number of markets, in its state colour. Outer ring: each state's markets split by how often they trade, on the frequency ordinal. Plain Vega because Vega-Lite has no partition layout. States too small to label inside the ring are named in the legend on the left.",
  "height": 340,
  "autosize": {
    "type": "fit",
    "contains": "padding",
    "resize": true
  },
  "signals": [
    {
      "name": "width",
      "init": "isFinite(containerSize()[0]) && containerSize()[0] > 0 ? containerSize()[0] : 420",
      "on": [
        {
          "events": "window:resize",
          "update": "isFinite(containerSize()[0]) && containerSize()[0] > 0 ? containerSize()[0] : width"
        }
      ]
    },
    {
      "name": "radius",
      "update": "max(60, min(width, height) / 2 - 16)"
    },
    {
      "name": "cx",
      "update": "width / 2"
    },
    {
      "name": "cy",
      "update": "height / 2"
    },
    {
      "name": "hoverState",
      "value": null,
      "on": [
        {
          "events": "@sunburst:pointerover",
          "update": "datum.state"
        },
        {
          "events": "@sunburst:pointerout",
          "update": "null"
        }
      ]
    }
  ],
  "data": [
    {
      "name": "leaves",
      "url": "data/frequency_by_state.csv",
      "format": {
        "type": "csv",
        "parse": {
          "markets": "number"
        }
      },
      "transform": [
        {
          "type": "joinaggregate",
          "groupby": [
            "state"
          ],
          "fields": [
            "markets"
          ],
          "ops": [
            "sum"
          ],
          "as": [
            "state_total"
          ]
        },
        {
          "type": "formula",
          "as": "id",
          "expr": "datum.state + '|' + datum.frequency"
        },
        {
          "type": "formula",
          "as": "parent",
          "expr": "datum.state"
        },
        {
          "type": "formula",
          "as": "size",
          "expr": "datum.markets"
        },
        {
          "type": "formula",
          "as": "share",
          "expr": "datum.markets / datum.state_total"
        },
        {
          "type": "formula",
          "as": "order",
          "expr": "indexof(['Weekly','Fortnightly','Monthly','Irregular'], datum.frequency)"
        }
      ]
    },
    {
      "name": "states",
      "source": "leaves",
      "transform": [
        {
          "type": "aggregate",
          "groupby": [
            "state"
          ],
          "fields": [
            "markets"
          ],
          "ops": [
            "sum"
          ],
          "as": [
            "state_total"
          ]
        },
        {
          "type": "joinaggregate",
          "fields": [
            "state_total"
          ],
          "ops": [
            "sum"
          ],
          "as": [
            "grand_total"
          ]
        },
        {
          "type": "formula",
          "as": "id",
          "expr": "datum.state"
        },
        {
          "type": "formula",
          "as": "parent",
          "expr": "'root'"
        },
        {
          "type": "formula",
          "as": "size",
          "expr": "0"
        },
        {
          "type": "formula",
          "as": "share",
          "expr": "datum.state_total / datum.grand_total"
        },
        {
          "type": "formula",
          "as": "order",
          "expr": "-datum.state_total * 100 + indexof(['NSW','VIC','QLD','WA','SA','TAS','ACT','NT'], datum.state)"
        }
      ]
    },
    {
      "name": "top",
      "values": [
        {
          "id": "root",
          "parent": null,
          "size": 0,
          "order": 0
        }
      ]
    },
    {
      "name": "tree",
      "source": [
        "top",
        "states",
        "leaves"
      ],
      "transform": [
        {
          "type": "stratify",
          "key": "id",
          "parentKey": "parent"
        },
        {
          "type": "partition",
          "field": "size",
          "sort": {
            "field": "data.order",
            "order": "ascending"
          },
          "size": [
            {
              "signal": "2 * PI"
            },
            {
              "value": 1
            }
          ],
          "as": [
            "a0",
            "p0",
            "a1",
            "p1",
            "depth",
            "children"
          ]
        },
        {
          "type": "filter",
          "expr": "datum.depth > 0"
        },
        {
          "type": "formula",
          "as": "r0",
          "expr": "radius * (datum.depth === 1 ? 0.3 : 0.64)"
        },
        {
          "type": "formula",
          "as": "r1",
          "expr": "radius * (datum.depth === 1 ? 0.64 : 1)"
        },
        {
          "type": "formula",
          "as": "amid",
          "expr": "(datum.a0 + datum.a1) / 2"
        },
        {
          "type": "formula",
          "as": "rmid",
          "expr": "(datum.r0 + datum.r1) / 2"
        },
        {
          "type": "formula",
          "as": "arclen",
          "expr": "(datum.a1 - datum.a0) * datum.rmid"
        },
        {
          "type": "formula",
          "as": "labelw",
          "expr": "datum.depth === 1 ? length({'NSW':'New South Wales','VIC':'Victoria','QLD':'Queensland','SA':'South Australia','WA':'Western Australia','TAS':'Tasmania','NT':'Northern Territory','ACT':'Australian Capital Territory'}[datum.state]) * 7.2 + 20 : 0"
        }
      ]
    },
    {
      "name": "stateLabels",
      "source": "tree",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.depth === 1 && datum.arclen > datum.labelw"
        }
      ]
    },
    {
      "name": "centre",
      "source": "states",
      "transform": [
        {
          "type": "aggregate",
          "fields": [
            "state_total"
          ],
          "ops": [
            "sum"
          ],
          "as": [
            "total"
          ]
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "state",
      "type": "ordinal",
      "domain": [
        "NSW",
        "VIC",
        "QLD",
        "WA",
        "SA",
        "TAS",
        "ACT",
        "NT"
      ],
      "range": [
        "#33b5ff",
        "#5a72ff",
        "#e8318c",
        "#ffd92e",
        "#2fe0c5",
        "#a3c22b",
        "#767676",
        "#A6A6A6"
      ]
    },
    {
      "name": "freq",
      "type": "ordinal",
      "domain": [
        "Weekly",
        "Fortnightly",
        "Monthly",
        "Irregular"
      ],
      "range": [
        "#4f2c00",
        "#8c5600",
        "#c58d41",
        "#ddac6e"
      ]
    }
  ],
  "legends": [
    {
      "fill": "freq",
      "orient": "top",
      "direction": "horizontal",
      "symbolType": "square",
      "columnPadding": 12
    },
    {
      "fill": "state",
      "title": "State",
      "orient": "left",
      "direction": "vertical",
      "symbolType": "square",
      "encode": {
        "symbols": {
          "update": {
            "stroke": {
              "value": null
            }
          }
        },
        "labels": {
          "update": {
            "text": {
              "signal": "{'NSW':'New South Wales','VIC':'Victoria','QLD':'Queensland','SA':'South Australia','WA':'Western Australia','TAS':'Tasmania','NT':'Northern Territory','ACT':'Australian Capital Territory'}[datum.value]"
            }
          }
        }
      }
    }
  ],
  "marks": [
    {
      "name": "sunburst",
      "type": "arc",
      "from": {
        "data": "tree"
      },
      "encode": {
        "enter": {
          "cornerRadius": {
            "value": 0
          }
        },
        "update": {
          "x": {
            "signal": "cx"
          },
          "y": {
            "signal": "cy"
          },
          "startAngle": {
            "field": "a0"
          },
          "endAngle": {
            "field": "a1"
          },
          "innerRadius": {
            "field": "r0"
          },
          "outerRadius": {
            "field": "r1"
          },
          "fill": [
            {
              "test": "datum.depth === 1",
              "scale": "state",
              "field": "state"
            },
            {
              "scale": "freq",
              "field": "frequency"
            }
          ],
          "fillOpacity": {
            "signal": "hoverState && datum.state !== hoverState ? 0.3 : 1"
          },
          "tooltip": [
            {
              "test": "datum.depth === 1",
              "signal": "{'State': {'NSW':'New South Wales','VIC':'Victoria','QLD':'Queensland','SA':'South Australia','WA':'Western Australia','TAS':'Tasmania','NT':'Northern Territory','ACT':'Australian Capital Territory'}[datum.state], 'Markets': datum.state_total, 'Share of all markets': format(datum.share, '.0%')}"
            },
            {
              "signal": "{'State': {'NSW':'New South Wales','VIC':'Victoria','QLD':'Queensland','SA':'South Australia','WA':'Western Australia','TAS':'Tasmania','NT':'Northern Territory','ACT':'Australian Capital Territory'}[datum.state], 'Trades': datum.frequency, 'Markets': datum.markets, 'Share of the state\\'s markets': format(datum.share, '.0%')}"
            }
          ]
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "stateLabels"
      },
      "interactive": false,
      "encode": {
        "update": {
          "x": {
            "signal": "cx + sin(datum.amid) * datum.rmid"
          },
          "y": {
            "signal": "cy - cos(datum.amid) * datum.rmid"
          },
          "text": {
            "signal": "{'NSW':'New South Wales','VIC':'Victoria','QLD':'Queensland','SA':'South Australia','WA':'Western Australia','TAS':'Tasmania','NT':'Northern Territory','ACT':'Australian Capital Territory'}[datum.state]"
          },
          "align": {
            "value": "center"
          },
          "baseline": {
            "value": "middle"
          },
          "fill": {
            "value": "#1c1f23"
          },
          "fontWeight": {
            "value": 700
          },
          "fontSize": {
            "value": 11.5
          },
          "opacity": {
            "signal": "hoverState && datum.state !== hoverState ? 0.5 : 1"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "centre"
      },
      "interactive": false,
      "encode": {
        "update": {
          "x": {
            "signal": "cx"
          },
          "y": {
            "signal": "cy - 2"
          },
          "text": {
            "field": "total"
          },
          "align": {
            "value": "center"
          },
          "baseline": {
            "value": "alphabetic"
          },
          "font": {
            "value": "Georgia, \"Iowan Old Style\", \"Times New Roman\", Times, serif"
          },
          "fontSize": {
            "value": 26
          },
          "fill": {
            "value": "#1C1F23"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "centre"
      },
      "interactive": false,
      "encode": {
        "update": {
          "x": {
            "signal": "cx"
          },
          "y": {
            "signal": "cy + 6"
          },
          "text": {
            "value": "markets"
          },
          "align": {
            "value": "center"
          },
          "baseline": {
            "value": "top"
          },
          "fontSize": {
            "value": 11.5
          }
        }
      }
    }
  ]
}
