{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Cumulative share of local government areas, and of Australia's land area, within a given distance of a farmers' market.",
  "width": "container",
  "height": 300,
  "data": {
    "url": "data/coverage_curve.csv"
  },
  "transform": [
    {
      "filter": "datum.km <= 200"
    },
    {
      "fold": [
        "pct_lgas",
        "pct_land_area"
      ],
      "as": [
        "measure",
        "pct"
      ]
    },
    {
      "calculate": "datum.measure == 'pct_lgas' ? 'Local government areas' : 'Australia\\u2019s land area'",
      "as": "Measure"
    }
  ],
  "encoding": {
    "x": {
      "field": "km",
      "type": "quantitative",
      "title": "Distance to the nearest farmers' market (km)",
      "scale": {
        "domain": [
          0,
          200
        ],
        "nice": false
      },
      "axis": {
        "values": [
          0,
          25,
          50,
          75,
          100,
          125,
          150,
          175,
          200
        ]
      }
    },
    "y": {
      "field": "pct",
      "type": "quantitative",
      "title": "Cumulative share (%)",
      "scale": {
        "domain": [
          0,
          100
        ]
      },
      "axis": {
        "grid": true
      }
    },
    "color": {
      "field": "Measure",
      "type": "nominal",
      "sort": [
        "Local government areas",
        "Australia’s land area"
      ],
      "legend": {
        "orient": "top-left",
        "title": null
      },
      "scale": {
        "domain": [
          "Local government areas",
          "Australia’s land area"
        ],
        "range": [
          "#243b51",
          "#b83025"
        ]
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "interpolate": "monotone",
        "strokeWidth": 2
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 45
      },
      "encoding": {
        "opacity": {
          "condition": {
            "param": "hover",
            "empty": false,
            "value": 1
          },
          "value": 0
        }
      },
      "params": [
        {
          "name": "hover",
          "select": {
            "type": "point",
            "on": "pointerover",
            "fields": [
              "km"
            ],
            "nearest": true,
            "clear": "pointerout"
          }
        }
      ]
    },
    {
      "transform": [
        {
          "filter": {
            "param": "hover",
            "empty": false
          }
        }
      ],
      "mark": {
        "type": "rule",
        "strokeWidth": 1,
        "strokeDash": [
          3,
          3
        ]
      },
      "encoding": {
        "color": {
          "value": "#767c83"
        },
        "tooltip": [
          {
            "field": "km",
            "type": "quantitative",
            "title": "Within (km)"
          },
          {
            "field": "Measure",
            "type": "nominal",
            "title": "Measure"
          },
          {
            "field": "pct",
            "type": "quantitative",
            "title": "Share",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.km == 50"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 7,
        "dy": -9,
        "fontSize": 11.5,
        "fontWeight": 600
      },
      "encoding": {
        "text": {
          "field": "pct",
          "type": "quantitative",
          "format": ".0f"
        },
        "color": {
          "value": "#474d54"
        }
      }
    }
  ]
}
