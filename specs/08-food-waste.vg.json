{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Waffle chart of where Australia's 7.3 million tonnes of annual food waste happens. 100 squares, one per percentage point, so each square is about 73,000 tonnes. Squares fill row by row from the top left, largest share first. The grid is always 10 x 10, left-aligned with the legend and card edge.",
  "width": "container",
  "height": "container",
  "params": [
    {
      "name": "cols",
      "value": 10
    },
    {
      "name": "rows",
      "expr": "100 / cols"
    },
    {
      "name": "cell",
      "expr": "floor(min(width / cols, height / rows))"
    },
    {
      "name": "gap",
      "expr": "max(2, round(cell * 0.12))"
    },
    {
      "name": "offsetX",
      "expr": "(width-cell*cols) / 2"
    },
    {
      "name": "offsetY",
      "expr": "(height - cell * rows) / 2"
    }
  ],
  "data": {
    "url": "data/dcceew_food_waste.csv"
  },
  "transform": [
    {
      "window": [
        {
          "op": "sum",
          "field": "share_pct",
          "as": "cum_end"
        }
      ],
      "sort": [
        {
          "field": "share_pct",
          "order": "descending"
        }
      ],
      "frame": [
        null,
        0
      ]
    },
    {
      "calculate": "datum.cum_end - datum.share_pct",
      "as": "cum_start"
    },
    {
      "calculate": "datum.sector + '  ' + datum.share_pct + '%'",
      "as": "label"
    },
    {
      "calculate": "sequence(datum.cum_start, datum.cum_end)",
      "as": "cells"
    },
    {
      "flatten": [
        "cells"
      ],
      "as": [
        "i"
      ]
    },
    {
      "calculate": "datum.i % cols",
      "as": "col"
    },
    {
      "calculate": "floor(datum.i / cols)",
      "as": "row"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "rect",
        "cornerRadius": 2,
        "strokeWidth": 0,
        "x": {
          "expr": "offsetX + datum.col * cell"
        },
        "x2": {
          "expr": "offsetX + (datum.col + 1) * cell - gap"
        },
        "y": {
          "expr": "offsetY + datum.row * cell"
        },
        "y2": {
          "expr": "offsetY + (datum.row + 1) * cell - gap"
        }
      },
      "encoding": {
        "color": {
          "field": "label",
          "type": "nominal",
          "title": null,
          "sort": {
            "field": "cum_start"
          },
          "scale": {
            "range": [
              "#FFD8B1",
              "#b83025",
              "#B0E0E6",
              "#FDD7E4"
            ]
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "columns": {
              "expr": "width < 440 ? 1 : 2"
            },
            "labelLimit": 300,
            "symbolType": "square"
          }
        },
        "tooltip": [
          {
            "field": "sector",
            "type": "nominal",
            "title": "Where"
          },
          {
            "field": "tonnes_million",
            "type": "quantitative",
            "title": "Million tonnes a year"
          },
          {
            "field": "share_pct",
            "type": "quantitative",
            "title": "Share (%)"
          },
          {
            "field": "note",
            "type": "nominal",
            "title": "Note"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "t": [
              "← A stall that sells the",
              "misshapen carrot does more",
              "for emissions than the short",
              "drive it arrived on."
            ]
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "fontSize": 12,
        "lineHeight": 16,
        "color": "#1c1f23",
        "tooltip": false,
        "x": {
          "expr": "offsetX + cell * cols + 10"
        },
        "y": {
          "expr": "offsetY + cell * 4.5"
        }
      },
      "encoding": {
        "text": {
          "field": "t"
        }
      }
    }
  ]
}
