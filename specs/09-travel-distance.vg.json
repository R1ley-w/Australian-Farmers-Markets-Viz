{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "How far stallholders travel to their main farmers' market, with the cumulative share overlaid.",
  "width": "container",
  "height": 300,
  "data": {
    "url": "data/rirdc_travel_distance.csv"
  },
  "encoding": {
    "x": {
      "field": "bandLabel",
      "type": "nominal",
      "title": "Distance travelled to their main market",
      "sort": [
        "20 kilometres or less",
        "21–50 kilometres",
        "51–100 kilometres",
        "101–200 kilometres",
        "201 kilometres or more"
      ],
      "axis": {
        "labelExpr": "[slice(datum.label, 0, indexof(datum.label, ' kilometres')), 'kilometres', trim(slice(datum.label, indexof(datum.label, ' kilometres') + 11))]",
        "labelAngle": 0
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "cornerRadiusEnd": 4,
        "width": {
          "band": 0.62
        }
      },
      "encoding": {
        "y": {
          "field": "share_pct",
          "type": "quantitative",
          "title": "Share of stallholders (%)",
          "scale": {
            "domain": [
              0,
              100
            ]
          },
          "axis": {
            "grid": true
          }
        },
        "color": {
          "value": "#ddac6e"
        },
        "tooltip": [
          {
            "field": "bandLabel",
            "type": "nominal",
            "title": "Distance"
          },
          {
            "field": "share_pct",
            "type": "quantitative",
            "title": "Share of stallholders (%)"
          },
          {
            "field": "cumulative_pct",
            "type": "quantitative",
            "title": "Cumulative (%)"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "dy": -8,
        "fontWeight": 600,
        "fontSize": 12
      },
      "encoding": {
        "y": {
          "field": "share_pct",
          "type": "quantitative"
        },
        "text": {
          "field": "share_pct",
          "type": "quantitative",
          "format": ".0f"
        },
        "color": {
          "value": "#474d54"
        }
      }
    },
    {
      "mark": {
        "type": "line",
        "strokeWidth": 2,
        "point": {
          "filled": true,
          "size": 60
        },
        "interpolate": "monotone"
      },
      "encoding": {
        "y": {
          "field": "cumulative_pct",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              100
            ]
          }
        },
        "color": {
          "value": "#b83025"
        },
        "tooltip": [
          {
            "field": "bandLabel",
            "type": "nominal",
            "title": "Within"
          },
          {
            "field": "cumulative_pct",
            "type": "quantitative",
            "title": "Cumulative share (%)"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.order == 2"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 8,
        "dy": -6,
        "fontSize": 11.5,
        "fontWeight": 600
      },
      "encoding": {
        "y": {
          "field": "cumulative_pct",
          "type": "quantitative"
        },
        "text": {
          "value": "57% within 50 kilometres"
        },
        "color": {
          "value": "#b83025"
        }
      }
    }
  ],
  "transform": [
    {
      "calculate": "replace(datum.band, ' km', ' kilometres')",
      "as": "bandLabel"
    }
  ]
}
