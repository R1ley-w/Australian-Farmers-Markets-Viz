{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "What stallholders sell at Australian farmers' markets, by share of stallholders offering each product category.",
  "width": "container",
  "height": 430,
  "data": {
    "url": "data/rirdc_product_mix.csv"
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "cornerRadiusEnd": 3,
        "height": {
          "band": 0.72
        }
      },
      "encoding": {
        "color": {
          "field": "group",
          "type": "nominal",
          "title": null,
          "sort": [
            "Fresh produce",
            "Value-added",
            "Protein",
            "Drinks",
            "Non-food",
            "Other"
          ],
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "columns": 3
          },
          "scale": {
            "domain": [
              "Fresh produce",
              "Value-added",
              "Protein",
              "Drinks",
              "Non-food",
              "Other"
            ],
            "range": [
              "#2f363d",
              "#444d56",
              "#596571",
              "#727f8d",
              "#8e9baa",
              "#abb7c5"
            ]
          }
        },
        "tooltip": [
          {
            "field": "category",
            "type": "nominal",
            "title": "Product"
          },
          {
            "field": "group",
            "type": "nominal",
            "title": "Group"
          },
          {
            "field": "share_pct",
            "type": "quantitative",
            "title": "Share of stallholders (%)"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 6,
        "fontSize": 11.5
      },
      "encoding": {
        "text": {
          "field": "share_pct",
          "type": "quantitative",
          "format": ".0f"
        },
        "color": {
          "value": "#767c83"
        }
      }
    }
  ],
  "encoding": {
    "y": {
      "field": "category",
      "type": "nominal",
      "title": null,
      "sort": [
        "Fruit",
        "Vegetables",
        "Value-added fruit and vegetable",
        "Baked goods",
        "Meat",
        "Herbs and spices",
        "Other",
        "Prepared food and drinks",
        "Honey and related products",
        "Non-alcoholic beverages",
        "Nuts",
        "Oils",
        "Plants",
        "Alcohol and beverages",
        "Condiments",
        "Dairy and cheese products",
        "Flowers",
        "Poultry and eggs",
        "Compost or garden inputs",
        "Confectionery"
      ],
      "axis": {
        "labelLimit": 210
      }
    },
    "x": {
      "field": "share_pct",
      "type": "quantitative",
      "title": "Share of stallholders offering it (%)",
      "scale": {
        "domain": [
          0,
          17
        ]
      },
      "axis": {
        "grid": true
      }
    }
  }
}
