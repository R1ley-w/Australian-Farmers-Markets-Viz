{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Greenhouse gas emissions per kilogram of food, split by supply-chain stage. Transport, the only stage picked out in the highlight colour, is a thin slice of almost every food's footprint.",
  "width": "container",
  "height": 430,
  "data": {
    "url": "data/owid_food_emissions_supply_chain.csv"
  },
  "params": [
    {
      "name": "mode",
      "value": "Absolute",
      "bind": {
        "input": "radio",
        "options": [
          "Absolute",
          "Share"
        ],
        "labels": [
          "Kilograms of greenhouse gases per kilogram of food",
          "Share of each food's own footprint"
        ],
        "name": "Show  "
      }
    }
  ],
  "transform": [
    {
      "filter": {
        "field": "entity",
        "oneOf": [
          "Beef (beef herd)",
          "Lamb & Mutton",
          "Cheese",
          "Pig Meat",
          "Poultry Meat",
          "Eggs",
          "Milk",
          "Rice",
          "Tofu",
          "Wheat & Rye",
          "Berries & Grapes",
          "Other Fruit",
          "Apples",
          "Root Vegetables",
          "Other Vegetables",
          "Potatoes"
        ]
      }
    },
    {
      "fold": [
        "food_emissions_land_use",
        "food_emissions_animal_feed",
        "food_emissions_farm",
        "food_emissions_processing",
        "food_emissions_transport",
        "food_emissions_retail",
        "food_emissions_packaging",
        "food_emissions_losses"
      ],
      "as": [
        "stage_raw",
        "kg"
      ]
    },
    {
      "calculate": "{'food_emissions_land_use':'Land use change','food_emissions_animal_feed':'Animal feed','food_emissions_farm':'Farm','food_emissions_processing':'Processing','food_emissions_transport':'Transport','food_emissions_retail':'Retail','food_emissions_packaging':'Packaging','food_emissions_losses':'Losses'}[datum.stage_raw]",
      "as": "Stage"
    },
    {
      "calculate": "indexof(['Land use change','Animal feed','Farm','Processing','Transport','Retail','Packaging','Losses'], datum.Stage)",
      "as": "stage_order"
    },
    {
      "calculate": "max(datum.kg, 0)",
      "as": "kg_pos"
    },
    {
      "joinaggregate": [
        {
          "op": "sum",
          "field": "kg_pos",
          "as": "total"
        }
      ],
      "groupby": [
        "entity"
      ]
    },
    {
      "calculate": "datum.kg_pos / datum.total",
      "as": "share"
    },
    {
      "calculate": "mode == 'Share' ? datum.share : datum.kg_pos",
      "as": "value"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "bar",
        "height": {
          "band": 0.76
        }
      },
      "encoding": {
        "y": {
          "field": "entity",
          "type": "nominal",
          "title": null,
          "sort": {
            "field": "total",
            "op": "max",
            "order": "descending"
          },
          "axis": {
            "labelLimit": 160
          }
        },
        "x": {
          "field": "value",
          "type": "quantitative",
          "stack": "zero",
          "axis": {
            "grid": true,
            "labelExpr": "mode == 'Share' ? format(datum.value, '.0%') : format(datum.value, '~s')",
            "title": {
              "expr": "mode == 'Share' ? 'Share of each food\\'s footprint' : 'Kilograms of greenhouse gases per kilogram of food'"
            }
          },
          "scale": {
            "nice": false
          }
        },
        "color": {
          "field": "Stage",
          "type": "nominal",
          "title": null,
          "scale": {
            "domain": [
              "Land use change",
              "Animal feed",
              "Farm",
              "Processing",
              "Transport",
              "Retail",
              "Packaging",
              "Losses"
            ],
            "range": [
              "#5d6b78",
              "#7f8b97",
              "#a7b0b9",
              "#c9ced3",
              "#b83025",
              "#d9dcdf",
              "#b9c0c6",
              "#8f99a3"
            ]
          },
          "legend": {
            "orient": "top",
            "direction": "horizontal",
            "columns": 4
          }
        },
        "order": {
          "field": "stage_order",
          "type": "quantitative",
          "sort": "ascending"
        },
        "tooltip": [
          {
            "field": "entity",
            "type": "nominal",
            "title": "Food"
          },
          {
            "field": "Stage",
            "type": "nominal",
            "title": "Stage"
          },
          {
            "field": "kg_pos",
            "type": "quantitative",
            "title": "Kilograms of greenhouse gases per kilogram",
            "format": ".2f"
          },
          {
            "field": "share",
            "type": "quantitative",
            "title": "Share of its footprint",
            "format": ".1%"
          },
          {
            "field": "total",
            "type": "quantitative",
            "title": "Total footprint",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "entity": "Cheese",
            "label": [
              "Transport (red) is under 1 kg for every food here.",
              "For beef it is 0.5 kg of a 99 kg footprint: what you",
              "eat matters far more than how far it travelled."
            ],
            "value": 33
          }
        ]
      },
      "transform": [
        {
          "filter": "mode == 'Absolute'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "fontSize": 12,
        "lineHeight": 16,
        "tooltip": false,
        "color": "#1c1f23",
        "dy": 6
      },
      "encoding": {
        "y": {
          "field": "entity",
          "type": "nominal",
          "sort": {
            "field": "total",
            "op": "max",
            "order": "descending"
          }
        },
        "x": {
          "field": "value",
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        }
      }
    }
  ]
}
