{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Number of farmers' markets by trading day and opening hour.",
  "width": "container",
  "height": "container",
  "data": {
    "url": "data/day_time_heatmap.csv",
    "format": {
      "type": "csv",
      "parse": {
        "start_hour": "number",
        "markets": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "datum.day != 'Unknown'"
    }
  ],
  "mark": {
    "type": "rect",
    "cornerRadius": 2
  },
  "encoding": {
    "x": {
      "field": "start_hour",
      "type": "ordinal",
      "title": "Opening time (24-hour clock)",
      "axis": {
        "labelExpr": "(datum.value < 10 ? '0' : '') + datum.value + ':00'"
      },
      "sort": "ascending"
    },
    "y": {
      "field": "day",
      "type": "ordinal",
      "title": null,
      "sort": [
        "Monday",
        "Tuesday",
        "Wednesday",
        "Thursday",
        "Friday",
        "Saturday",
        "Sunday"
      ],
      "scale": {
        "domain": [
          "Monday",
          "Tuesday",
          "Wednesday",
          "Thursday",
          "Friday",
          "Saturday",
          "Sunday"
        ]
      }
    },
    "color": {
      "field": "markets",
      "type": "quantitative",
      "title": "Markets",
      "scale": {
        "range": [
          "#fee0d2",
          "#fcbba1",
          "#fc9272",
          "#fb6a4a",
          "#ef3b2c",
          "#cb181d",
          "#99000d"
        ],
        "domainMin": 0
      },
      "legend": {
        "orient": "top",
        "direction": "horizontal",
        "gradientLength": 130
      }
    },
    "tooltip": [
      {
        "field": "day",
        "type": "nominal",
        "title": "Day"
      },
      {
        "field": "start_hour",
        "type": "quantitative",
        "title": "Opening hour (24-hour clock)"
      },
      {
        "field": "markets",
        "type": "quantitative",
        "title": "Markets"
      }
    ]
  }
}
