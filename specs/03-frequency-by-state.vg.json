{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "Marimekko (mosaic) chart of trading frequency by state. Each band is a state; its height is the state's number of markets and it is split by how often those markets trade, so every block's area is a number of markets. Replaces the sunburst: state and trading frequency are two independent categories, not a hierarchy. Plain Vega so the band positions can be computed with a window transform and every state name sits level beside its band. Bands run top to bottom from the most markets to the fewest.",
  "height": 400,
  "padding": {
    "top": 4,
    "left": 0,
    "right": 8,
    "bottom": 0
  },
  "autosize": {
    "type": "fit-x",
    "contains": "padding",
    "resize": true
  },
  "signals": [
    {
      "name": "width",
      "init": "isFinite(containerSize()[0]) && containerSize()[0] > 0 ? containerSize()[0] : 640",
      "on": [
        {
          "events": "window:resize",
          "update": "isFinite(containerSize()[0]) && containerSize()[0] > 0 ? containerSize()[0] : width"
        }
      ]
    },
    {
      "name": "hoverState",
      "value": null,
      "on": [
        {
          "events": "@block:pointerover",
          "update": "datum.state"
        },
        {
          "events": "@block:pointerout",
          "update": "null"
        }
      ]
    }
  ],
  "data": [
    {
      "name": "leaves",
      "url": "data/frequency_by_state.csv",
      "format": {
        "type": "csv",
        "parse": {
          "markets": "number"
        }
      },
      "transform": [
        {
          "type": "formula",
          "as": "stateName",
          "expr": "{'NSW':'New South Wales','VIC':'Victoria','QLD':'Queensland','SA':'South Australia','WA':'Western Australia','TAS':'Tasmania','NT':'Northern Territory','ACT':'Australian Capital Territory'}[datum.state]"
        },
        {
          "type": "formula",
          "as": "freqOrder",
          "expr": "indexof([\"Weekly\", \"Fortnightly\", \"Monthly\", \"Irregular\"], datum.frequency)"
        },
        {
          "type": "joinaggregate",
          "groupby": [
            "state"
          ],
          "fields": [
            "markets"
          ],
          "ops": [
            "sum"
          ],
          "as": [
            "stateTotal"
          ]
        },
        {
          "type": "joinaggregate",
          "fields": [
            "markets"
          ],
          "ops": [
            "sum"
          ],
          "as": [
            "allMarkets"
          ]
        },
        {
          "type": "formula",
          "as": "share",
          "expr": "datum.markets / datum.stateTotal"
        },
        {
          "type": "stack",
          "groupby": [
            "state"
          ],
          "field": "markets",
          "sort": {
            "field": "freqOrder"
          },
          "offset": "normalize",
          "as": [
            "y0",
            "y1"
          ]
        }
      ]
    },
    {
      "name": "states",
      "source": "leaves",
      "transform": [
        {
          "type": "aggregate",
          "groupby": [
            "state",
            "stateName"
          ],
          "fields": [
            "markets"
          ],
          "ops": [
            "sum"
          ],
          "as": [
            "total"
          ]
        },
        {
          "type": "window",
          "sort": {
            "field": [
              "total",
              "state"
            ],
            "order": [
              "descending",
              "ascending"
            ]
          },
          "ops": [
            "sum"
          ],
          "fields": [
            "total"
          ],
          "as": [
            "cum"
          ]
        },
        {
          "type": "formula",
          "as": "x0",
          "expr": "datum.cum - datum.total"
        },
        {
          "type": "formula",
          "as": "x1",
          "expr": "datum.cum"
        }
      ]
    },
    {
      "name": "blocks",
      "source": "leaves",
      "transform": [
        {
          "type": "lookup",
          "from": "states",
          "key": "state",
          "fields": [
            "state"
          ],
          "values": [
            "x0",
            "x1"
          ]
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "y",
      "type": "linear",
      "range": [
        0,
        {
          "signal": "height"
        }
      ],
      "zero": true,
      "nice": false,
      "domain": {
        "data": "states",
        "field": "x1"
      }
    },
    {
      "name": "x",
      "type": "linear",
      "range": "width",
      "domain": [
        0,
        1
      ]
    },
    {
      "name": "freq",
      "type": "ordinal",
      "domain": [
        "Weekly",
        "Fortnightly",
        "Monthly",
        "Irregular"
      ],
      "range": [
        "#4f2c00",
        "#8c5600",
        "#c58d41",
        "#ddac6e"
      ]
    }
  ],
  "axes": [
    {
      "orient": "bottom",
      "scale": "x",
      "format": ".0%",
      "tickCount": {
        "signal": "width < 250 ? 2 : 5"
      },
      "grid": false,
      "title": "Share of the state's markets",
      "labelPadding": 4
    }
  ],
  "legends": [
    {
      "fill": "freq",
      "orient": "top",
      "direction": "horizontal",
      "symbolType": "square",
      "title": "Trades",
      "columnPadding": 14,
      "columns": {
        "signal": "width < 300 ? 2 : 4"
      }
    }
  ],
  "marks": [
    {
      "type": "rect",
      "name": "block",
      "from": {
        "data": "blocks"
      },
      "encode": {
        "enter": {
          "stroke": {
            "value": "#ffffff"
          },
          "strokeWidth": {
            "value": 1.5
          }
        },
        "update": {
          "y": {
            "scale": "y",
            "field": "x0"
          },
          "y2": {
            "scale": "y",
            "field": "x1"
          },
          "x": {
            "scale": "x",
            "field": "y0"
          },
          "x2": {
            "scale": "x",
            "field": "y1"
          },
          "fill": {
            "scale": "freq",
            "field": "frequency"
          },
          "fillOpacity": {
            "signal": "hoverState && datum.state !== hoverState ? 0.35 : 1"
          },
          "tooltip": {
            "signal": "{'State': datum.stateName, 'Trades': datum.frequency, 'Markets': datum.markets, 'Share of the state\\'s markets': format(datum.share, '.0%'), 'Share of all markets': format(datum.markets / datum.allMarkets, '.0%')}"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "block"
      },
      "interactive": false,
      "encode": {
        "update": {
          "x": {
            "signal": "(datum.x + datum.x2) / 2"
          },
          "y": {
            "signal": "(datum.y + datum.y2) / 2"
          },
          "align": {
            "value": "center"
          },
          "baseline": {
            "value": "middle"
          },
          "fontSize": {
            "value": 11.5
          },
          "fontWeight": {
            "value": 700
          },
          "text": {
            "signal": "datum.x2 - datum.x >= 34 && datum.y2 - datum.y >= 18 ? format(datum.datum.share, '.0%') : ''"
          },
          "fill": {
            "signal": "indexof(['Weekly','Fortnightly'], datum.datum.frequency) >= 0 ? '#ffffff' : '#1c1f23'"
          },
          "opacity": {
            "signal": "hoverState && datum.datum.state !== hoverState ? 0.4 : 1"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "states"
      },
      "interactive": false,
      "encode": {
        "update": {
          "x": {
            "value": -8
          },
          "y": {
            "signal": "scale('y', datum.x1) - scale('y', datum.x0) >= 14 ? (scale('y', datum.x0) + scale('y', datum.x1)) / 2 : scale('y', datum.x0)"
          },
          "dy": {
            "signal": "scale('y', datum.x1) - scale('y', datum.x0) >= 40 ? -7 : 0"
          },
          "align": {
            "value": "right"
          },
          "baseline": {
            "signal": "scale('y', datum.x1) - scale('y', datum.x0) >= 14 ? 'middle' : 'top'"
          },
          "fontSize": {
            "value": 11.5
          },
          "fontWeight": {
            "value": 700
          },
          "fill": {
            "value": "#1c1f23"
          },
          "text": {
            "field": "stateName"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "states"
      },
      "interactive": false,
      "encode": {
        "update": {
          "x": {
            "value": -8
          },
          "y": {
            "signal": "(scale('y', datum.x0) + scale('y', datum.x1)) / 2"
          },
          "dy": {
            "value": 8
          },
          "align": {
            "value": "right"
          },
          "baseline": {
            "value": "middle"
          },
          "fontSize": {
            "value": 11
          },
          "fill": {
            "value": "#767c83"
          },
          "text": {
            "signal": "scale('y', datum.x1) - scale('y', datum.x0) >= 40 ? datum.total + ' markets' : ''"
          }
        }
      }
    }
  ]
}
