{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "Farmers' markets per 100,000 people by Greater Capital City Statistical Area and rest-of-state.",
  "autosize": {
    "type": "pad",
    "resize": true
  },
  "signals": [
    {"name": "gratStep", "value": [5, 5]},
    {
      "name": "width",
      "init": "isFinite(containerSize()[0]) && containerSize()[0] > 0 ? containerSize()[0] : 760",
      "on": [
        {
          "events": "window:resize",
          "update": "isFinite(containerSize()[0]) && containerSize()[0] > 0 ? containerSize()[0] : width"
        }
      ]
    },
    {
      "name": "stacked",
      "update": "width < 600"
    },
    {
      "name": "height",
      "update": "stacked ? 556 : 500"
    },
    {
      "name": "insetW",
      "update": "stacked ? min(width, 340) : 290"
    },
    {
      "name": "insetH",
      "update": "136"
    },
    {
      "name": "mapW",
      "update": "stacked ? width : width - insetW - 16"
    },
    {
      "name": "mapH",
      "update": "stacked ? height - insetH - 16 - 64 : height"
    },
    {
      "name": "mapTop",
      "update": "stacked ? 64 : 0"
    },
    {
      "name": "insetX",
      "update": "stacked ? 0 : width - insetW"
    },
    {
      "name": "insetY",
      "update": "stacked ? height - insetH : (height - insetH) / 2 + 10"
    },
    {
      "name": "picked",
      "description": "The last two states clicked, oldest first. Clicking a picked state (on the map or its bar) removes it; a third pick drops the oldest.",
      "value": [],
      "on": [
        {
          "events": "click",
          "update": "item() && isObject(datum) && isString(datum.gccsa) ? (indexof(picked, datum.gccsa) >= 0 ? (picked[0] === datum.gccsa ? slice(picked, 1) : slice(picked, 0, 1)) : (length(picked) === 0 ? [datum.gccsa] : [peek(picked), datum.gccsa])) : picked"
        }
      ]
    }
  ],
  "data": [
    {
      "name": "graticule",
      "transform": [
        {"type": "graticule", "extent": [[112, -44], [154, -10]], "step": {"signal": "gratStep"}}
      ]
    },
    {
      "name": "density",
      "url": "data/gccsa_market_density.csv",
      "format": {
        "type": "csv",
        "parse": "auto"
      },
      "transform": [
        {"type": "formula", "as": "regionName", "expr": "({'Rest of NSW':'Rest of New South Wales','Rest of Vic.':'Rest of Victoria','Rest of Qld':'Rest of Queensland','Rest of SA':'Rest of South Australia','Rest of WA':'Rest of Western Australia','Rest of Tas.':'Rest of Tasmania','Rest of NT':'Rest of Northern Territory'}[datum.gccsa] || datum.gccsa)"},
        {"type": "formula", "as": "short",
         "expr": "datum.regionName === 'Australian Capital Territory' ? 'Canberra' : replace(datum.regionName, 'Greater ', '')"}
      ]
    },
    {
      "name" : "cities",
      "source" : "density",
      "transform": [{"type": "filter", "expr": "datum.kind === 'Capital city'"}]
    },
    {
      "name": "regions",
      "url": "data/gccsa.topo.json",
      "format": {
        "type": "topojson",
        "feature": "GCCSA_2021_AUST_GDA2020"
      },
      "transform": [
        {
          "type": "lookup",
          "from": "density",
          "key": "gccsa",
          "fields": [
            "properties.name"
          ],
          "values": ["gccsa", "regionName", "short", "state", "kind", "markets", "population", "markets_per_100k"]
        }
      ]
    },
    {
      "name": "pickedRegions",
      "source": "regions",
      "transform": [
        {
          "type": "filter",
          "expr": "indexof(picked, datum.gccsa) >= 0"
        }
      ]
    },
    {
      "name" : "pickedDensity",
      "source" : "density",
      "transform": [
        {"type": "filter", "expr": "indexof(picked, datum.gccsa) >= 0"},
        {"type": "formula", "as": "slot", "expr": "indexof(picked, datum.gccsa)"}
      ]
    }
  ],
  "projections": [
    {
      "name": "projection",
      "type": "conicEqualArea",
      "parallels": [-18, -36],
      "rotate" : [-132,0],
      "fit": {
        "signal": "data('regions')"
      },
      "extent": {
        "signal": "[[0, mapTop], [mapW, mapTop + mapH]]"
      }
    }
  ],
  "scales": [
    {
      "name": "density",
      "type": "linear",
      "domain": [
        0,
        2
      ],
      "clamp": true,
      "range": [
        "#deebf7",
        "#c6dbef",
        "#9ecae1",
        "#6baed6",
        "#4292c6",
        "#2171b5",
        "#084594"
      ]
    }
  ],
  "legends": [
    {
      "fill": "density",
      "type": "gradient",
      "orient": "top-left",
      "title": [
        "Markets per",
        "100,000 people"
      ],
      "gradientLength": 150,
      "format": ".1f",
      "values": [
        0,
        1,
        2
      ],
      "direction": "horizontal"
    }
  ],
  "marks": [
    {
      "name": "regionShapes",
      "type": "shape",
      "from": {
        "data": "regions"
      },
      "encode": {
        "update": {
          "fill": {
            "scale": "density",
            "field": "markets_per_100k"
          },
          "stroke": {
            "value": "#fdfdfc"
          },
          "strokeWidth": {
            "value": 0.8
          },
          "cursor": {
            "value": "pointer"
          },
          "tooltip": {
            "signal": "{'Region': datum.regionName, 'Markets': datum.markets, 'Population': format(datum.population, ','), 'Markets per 100,000 people': format(datum.markets_per_100k, '.2f'), ' ': 'Click to compare ' + datum.regionName}"
          }
        }
      },
      "transform": [
        {
          "type": "geoshape",
          "projection": "projection"
        }
      ]
    },
    {
      "type": "shape",
      "from": {
        "data": "regions"
      },
      "interactive": false,
      "encode": {
        "update": {
          "fill": {
            "value": null
          },
          "stroke": {
            "value": "#cdced1"
          },
          "strokeWidth": {
            "value": 0.5
          }
        }
      },
      "transform": [
        {
          "type": "geoshape",
          "projection": "projection"
        }
      ]
    },
    {
      "type": "shape",
      "from": {"data": "graticule"},
      "interactive": false,
      "encode": {
        "update": {
          "fill": {"value": null},
          "stroke": {"value": "#4a5058"},
          "strokeOpacity": {"value": 0.35},
          "strokeWidth": {"value": 0.6}
        }
      },
      "transform": [{"type": "geoshape", "projection": "projection"}]
    },
    {
      "name": "pickedOutline",
      "type": "shape",
      "from": {
        "data": "pickedRegions"
      },
      "interactive": false,
      "encode": {
        "update": {
          "fill": {
            "value": null
          },
          "stroke": {
            "value": "#b83025"
          },
          "strokeWidth": {
            "value": 2
          },
          "strokeJoin": {
            "value": "round"
          }
        }
      },
      "transform": [
        {
          "type": "geoshape",
          "projection": "projection"
        }
      ]
    },
    {
      "name": "cityDots",
      "type": "symbol",
      "from": {"data": "cities"},
      "encode": {
        "update": {
          "x": {"signal": "scale('projection', [datum.lng, datum.lat])[0]"},
          "y": {"signal": "scale('projection', [datum.lng, datum.lat])[1]"},
          "size": {"value": 150},
          "fill": {"scale": "density", "field": "markets_per_100k"},
          "stroke": {"signal": "indexof(picked, datum.gccsa) >= 0 ? '#b83025' : '#fdfdfc'"},
          "strokeWidth": {"signal": "indexof(picked, datum.gccsa) >= 0 ? 2.5 : 1.5"},
          "cursor": {"value": "pointer"},
          "tooltip": {"signal": "{'Region': datum.regionName, 'Markets': datum.markets, 'Population': format(datum.population, ','), 'Markets per 100,000 people': format(datum.markets_per_100k, '.2f'), ' ': 'Click to compare'}"}
        }
      }
    },
    {
      "name": "inset",
      "type": "group",
      "encode": {
        "update": {
          "x": {
            "signal": "insetX"
          },
          "y": {
            "signal": "insetY"
          },
          "width": {
            "signal": "insetW"
          },
          "height": {
            "signal": "insetH"
          },
          "fill": {
            "value": "#ffffff"
          },
          "stroke": {
            "value": "#e2e3e5"
          },
          "strokeWidth": {
            "value": 1
          },
          "cornerRadius": {
            "value": 4
          }
        }
      },
      "signals": [
        {
          "name": "labelW",
          "update": "0"
        },
        {
          "name": "valueW",
          "update": "112"
        },
        {
          "name": "barMax",
          "update": "max(40, insetW - 24 - labelW - valueW)"
        }
      ],
      "scales": [
        {
          "name": "barX",
          "type": "linear",
          "domain": {
            "data": "density",
            "field": "markets_per_100k"
          },
          "zero": true,
          "nice": false,
          "range": [
            0,
            {
              "signal": "barMax"
            }
          ]
        }
      ],
      "marks": [
        {
          "type": "text",
          "interactive": false,
          "encode": {
            "update": {
              "x": {
                "value": 12
              },
              "y": {
                "value": 20
              },
              "text": {
                "value": "Compare two regions"
              },
              "fontWeight": {
                "value": 700
              },
              "fontSize": {
                "value": 11.5
              },
              "fill": {
                "value": "#474d54"
              }
            }
          }
        },
        {
          "type": "text",
          "interactive": false,
          "encode": {
            "update": {
              "x": {
                "value": 12
              },
              "y": {
                "signal": "length(picked) === 0 ? 50 : insetH - 12"
              },
              "text": {
                "signal": "length(picked) === 0 ? ['Click any two regions on the map', 'to compare them here.'] : length(picked) === 1 ? 'Click one more region.' : 'Markets per 100,000 people'"
              },
              "lineHeight": {
                "value": 16
              },
              "fontSize": {
                "value": 11.5
              },
              "fill": {
                "value": "#767c83"
              }
            }
          }
        },
        {
          "name": "bars",
          "type": "rect",
          "from": {
            "data": "pickedDensity"
          },
          "encode": {
            "update": {
              "x": {
                "signal": "12 + labelW"
              },
              "width": {
                "scale": "barX",
                "field": "markets_per_100k"
              },
              "y": {
                "signal": "46 + datum.slot * 40"
              },
              "height": {
                "value": 18
              },
              "fill": {
                "scale": "density",
                "field": "markets_per_100k"
              },
              "cornerRadiusTopRight": {
                "value": 3
              },
              "cornerRadiusBottomRight": {
                "value": 3
              },
              "cursor": {
                "value": "pointer"
              },
              "tooltip": {
                "signal": "{'Region': datum.regionName, 'Markets': datum.markets, 'Population': format(datum.population, ','), 'Markets per 100,000 people': format(datum.markets_per_100k, '.2f'), ' ': 'Click to remove'}"
              }
            }
          }
        },
        {
          "type": "rule",
          "interactive": false,
          "encode": {
            "update": {
              "x": {
                "signal": "12 + labelW"
              },
              "x2": {
                "signal": "12 + labelW"
              },
              "y": {
                "value": 44
              },
              "y2": {
                "signal": "46 + (max(1, length(picked)) - 1) * 40 + 18"
              },
              "stroke": {
                "value": "#c3c6ca"
              },
              "opacity": {
                "signal": "length(picked) ? 1 : 0"
              }
            }
          }
        },
        {
          "type": "text",
          "from": {
            "data": "pickedDensity"
          },
          "interactive": false,
          "encode": {
            "update": {
              "x": {
                "value": 12
              },
              "y": {
                "signal": "38 + datum.slot * 40"
              },
              "baseline": {
                "value": "middle"
              },
              "text": {
                "field": "short"
              },
              "fontWeight": {
                "value": 700
              },
              "fontSize": {
                "value": 11.5
              },
              "fill": {
                "value": "#1c1f23"
              }
            }
          }
        },
        {
          "type": "text",
          "from": {
            "data": "pickedDensity"
          },
          "interactive": false,
          "encode": {
            "update": {
              "x": {
                "signal": "12 + labelW + scale('barX', datum.markets_per_100k) + 6"
              },
              "y": {
                "signal": "46 + datum.slot * 40 + 9"
              },
              "baseline": {
                "value": "middle"
              },
              "text": {
                "signal": "format(datum.markets_per_100k, '.2f') + '  ·  ' + datum.markets + (datum.markets === 1 ? ' market' : ' markets')"
              },
              "fontSize": {
                "value": 11.5
              },
              "fill": {
                "value": "#474d54"
              }
            }
          }
        }
      ]
    }
  ]
}
