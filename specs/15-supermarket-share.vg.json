{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Share of Australian supermarket grocery sales, from the ACCC's supermarkets inquiry final report.",
  "width": "container",
  "height": 330,
  "data": {
    "url": "data/accc_supermarket_share.csv"
  },
  "layer": [
    {
      "mark": {
        "type": "arc",
        "innerRadius": 72,
        "outerRadius": 120,
        "padAngle": 0.012,
        "cornerRadius": 3
      },
      "encoding": {
        "theta": {
          "field": "share_pct",
          "type": "quantitative",
          "stack": true
        },
        "order": {
          "field": "share_pct",
          "type": "quantitative",
          "sort": "descending"
        },
        "color": {
          "field": "retailer",
          "type": "nominal",
          "title": null,
          "sort": [
            "Woolworths",
            "Coles",
            "ALDI",
            "Independents",
            "Everyone else"
          ],
          "scale": {
            "domain": [
              "Woolworths",
              "Coles",
              "ALDI",
              "Metcash-supplied independents",
              "Everyone else"
            ],
            "range": [
              "#457b45",
              "#a8442a",
              "#4199c9",
              "#b68611",
              "#8a877f"
            ]
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "columns": 2,
            "labelLimit": 230
          }
        },
        "tooltip": [
          {
            "field": "retailer",
            "type": "nominal",
            "title": "Retailer"
          },
          {
            "field": "share_pct",
            "type": "quantitative",
            "title": "Share of grocery sales (%)"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "radius": 143,
        "fontSize": 12,
        "fontWeight": 600
      },
      "encoding": {
        "theta": {
          "field": "share_pct",
          "type": "quantitative",
          "stack": true
        },
        "order": {
          "field": "share_pct",
          "type": "quantitative",
          "sort": "descending"
        },
        "text": {
          "field": "share_pct",
          "type": "quantitative",
          "format": ".0f"
        },
        "color": {
          "value": "#4a4f3e"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "big": "67%"
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 32,
        "fontWeight": 660,
        "dy": -10
      },
      "encoding": {
        "text": {
          "field": "big",
          "type": "nominal"
        },
        "color": {
          "value": "#1f2417"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "small": "Coles + Woolworths"
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 11.5,
        "dy": 18
      },
      "encoding": {
        "text": {
          "field": "small",
          "type": "nominal"
        },
        "color": {
          "value": "#7c7f6e"
        }
      }
    }
  ]
}
