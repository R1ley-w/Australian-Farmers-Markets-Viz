{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Organisations that run more than one farmers' market, by number of markets run.",
  "width": "container",
  "height": "container",
  "data": {
    "url": "data/operators.csv"
  },
  "transform": [
    {
      "filter": "datum.markets >= 2"
    },
    {
      "calculate": "{'NSW':'New South Wales','VIC':'Victoria','QLD':'Queensland','SA':'South Australia','WA':'Western Australia','TAS':'Tasmania','NT':'Northern Territory','ACT':'Australian Capital Territory'}[datum.states]",
      "as": "stateName"
    },
    {
      "calculate": "replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(datum.operator, regexp('^SCPA - ', 'g'), ''), regexp(' ?\\\\((FAB|GSFMA)\\\\)', 'g'), ''), regexp('SAGE Sustainable', 'g'), 'Sustainable'), regexp('\\\\bSAGE\\\\b', 'g'), 'Sustainable Agriculture and Gardening Eurobodalla'), regexp('\\\\bInc\\\\b\\\\.?|\\\\bINC\\\\b', 'g'), 'Incorporated'), regexp('\\\\bPty Ltd\\\\b', 'g'), 'Proprietary Limited'), regexp('\\\\bPL\\\\b', 'g'), 'Proprietary Limited'), regexp('\\\\bAssoc\\\\b', 'g'), 'Association'), regexp('\\\\bMt\\\\b', 'g'), 'Mount'), regexp('\\\\bSt\\\\b', 'g'), 'Saint'), regexp('\\\\bSth\\\\b', 'g'), 'South'), regexp('\\\\bFM\\\\b', 'g'), 'Farmers’ Market'), regexp('\\\\bQLD\\\\b', 'g'), 'Queensland'), regexp('\\\\bNSW\\\\b', 'g'), 'New South Wales'), regexp('\\\\bCo\\\\b', 'g'), 'Company'), regexp('P&C', 'g'), 'Parents and Citizens Association'), regexp('\\\\bGC\\\\b', 'g'), 'Gold Coast')",
      "as": "operatorName"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "bar",
        "cornerRadiusEnd": 4,
        "height": 16
      },
      "encoding": {
        "color": {
          "field": "states",
          "type": "nominal",
          "title": "State",
          "scale": {
            "domain": [
              "VIC",
              "QLD"
            ],
            "range": [
              "#3d6b8f",
              "#8a8a2e"
            ]
          },
          "legend": {
            "orient": "bottom-right",
            "direction": "vertical",
            "labelExpr": "{'VIC':'Victoria','QLD':'Queensland'}[datum.label]"
          }
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 6,
        "fontWeight": 600
      },
      "encoding": {
        "text": {
          "field": "markets",
          "type": "quantitative"
        },
        "color": {
          "value": "#474d54"
        }
      }
    }
  ],
  "encoding": {
    "y": {
      "field": "operatorName",
      "type": "nominal",
      "title": null,
      "sort": [
        "Community Farmers Markets",
        "Regional Farmers' Markets",
        "Slow Food Melbourne",
        "Melbourne Farmers' Markets",
        "Queensland Farmers Markets"
      ],
      "axis": {
        "labelLimit": 240
      }
    },
    "x": {
      "field": "markets",
      "type": "quantitative",
      "title": "Markets run",
      "scale": {
        "domain": [
          0,
          5
        ]
      },
      "axis": {
        "values": [
          0,
          1,
          2,
          3,
          4,
          5
        ],
        "grid": true
      }
    },
    "tooltip": [
      {
        "field": "operatorName",
        "type": "nominal",
        "title": "Operator"
      },
      {
        "field": "markets",
        "type": "quantitative",
        "title": "Markets run"
      },
      {
        "field": "stateName",
        "type": "nominal",
        "title": "State"
      }
    ]
  }
}
